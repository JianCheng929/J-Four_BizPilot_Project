# BizPilot server — copy to "server/.env" and fill in. Never commit .env.

PORT=4000
# Where the web app runs (CORS + where OAuth callbacks send the user back)
APP_URL=http://localhost:5173
# Public URL of THIS server. Marketplaces (Shopee/Lazada/TikTok) must be able to
# redirect here, so for OAuth use a tunnel or deployed URL, e.g. https://bizpilot-api.example.com
PUBLIC_SERVER_URL=http://localhost:4000

# --- Supabase (required) ------------------------------------------------------
# Supabase → Project Settings → API. The service role key stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- WorkBuddy engine (BizPilot's own account; users never sign in) -------------
# Local: run "npm run workbuddy:login" once. Cloud: set WORKBUDDY_ADMIN_KEY, then sign in at /admin/workbuddy
# WORKBUDDY_ADMIN_KEY=
# Optional: use the CLI bundled inside the WorkBuddy desktop app instead of the npm one
# CODEBUDDY_CODE_PATH=C:\Users\YOU\AppData\Local\Programs\WorkBuddy\resources\app.asar.unpacked\cli\bin\codebuddy
# Optional (Pro plans only): API key instead of signing in
# CODEBUDDY_API_KEY=
# Optional: pin a model / step limit
# WORKBUDDY_MODEL=
# WORKBUDDY_MAX_TURNS=40
# Agent team (lead + research, inventory, sales, finance, marketing and quality-check sub-agents). Set to off for a single agent.
# WORKBUDDY_TEAM=on

# --- Integrations (optional) ---------------------------------------------------
# Normally you enter these in Settings → Integrations (stored per business in
# Supabase). Values here are used as defaults when nothing is saved in the app.

# Shopee Open Platform
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_ENV=live            # or sandbox

# Lazada Open Platform
# LAZADA_APP_KEY=
# LAZADA_APP_SECRET=

# TikTok Shop Partner Center
# TIKTOKSHOP_APP_KEY=
# TIKTOKSHOP_APP_SECRET=
# TIKTOKSHOP_SERVICE_ID=

# EasyParcel
# EASYPARCEL_API_KEY=
# EASYPARCEL_ENV=live        # or demo

# LHDN MyInvois
# MYINVOIS_CLIENT_ID=
# MYINVOIS_CLIENT_SECRET=
# MYINVOIS_ENV=sandbox       # or prod
# MYINVOIS_ON_BEHALF_OF=     # intermediaries only

# Meta (Facebook Page + Instagram)
# META_PAGE_ID=
# META_PAGE_TOKEN=
# META_IG_USER_ID=

# Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# AI images: the first one with a key is used.
# Free images: Cloudflare Workers AI (dash.cloudflare.com > AI > Workers AI > Use REST API)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# GEMINI_API_KEY=        # Google AI Studio key (aistudio.google.com/apikey), best value
# OPENAI_API_KEY=        # gpt-image-1
# (Kling keys below also make images.) Without any key a free, low-quality,
# rate-limited service is used; POLLINATIONS_TOKEN raises its limit.
# POLLINATIONS_TOKEN=

# Kling AI video (real motion video). From the Kling developer console → API keys.
# Without these, make_video builds a slideshow video from AI images instead.
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# KLING_API_BASE=https://api-singapore.klingai.com
# KLING_MODEL=kling-v1-6
# KLING_MODE=std
