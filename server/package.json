    "nodemailer": "^7.0.10",
    "tsx": "^4.20.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.3",
    "typescript": "~5.9.3"
